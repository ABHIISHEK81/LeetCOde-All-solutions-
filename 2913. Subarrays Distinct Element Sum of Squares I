// 2913. Subarrays Distinct Element Sum of Squares I  //



class Solution(object):
    def sumCounts(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        total = 0
        for i in range(len(nums)):
            seen = set()
            for x in nums[i:]: 
                seen.add(x)  
                total += len(seen) ** 2
        return total
