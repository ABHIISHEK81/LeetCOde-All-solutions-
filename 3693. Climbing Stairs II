//  3693. Climbing Stairs II  //



class Solution(object):
    def climbStairs(self, n, costs):
        """
        :type n: int
        :type costs: List[int]
        :rtype: int
        """
        a = float('inf')
        b = float('inf')
        c = 0

        for i in range(1, n + 1):
            minCost = float('inf')

            minCost = min(minCost, c + 1 + costs[i - 1])

            if b != float('inf'):
                minCost = min(minCost, b + 4 + costs[i - 1])

            if a != float('inf'):
                minCost = min(minCost, a + 9 + costs[i - 1])

            a = b
            b = c
            c = minCost

        return c
