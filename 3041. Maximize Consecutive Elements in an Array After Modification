//  3041. Maximize Consecutive Elements in an Array After Modification  //



class Solution(object):
    def maxSelectedElements(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        nums.sort()
        mx = nums[-1]
        dp = [0] * (mx + 2)
        ans = 1
        for x in nums:
            dp[x + 1] = dp[x] + 1
            dp[x] = dp[x - 1] + 1
            ans = max(ans, dp[x], dp[x + 1])
        return ans
