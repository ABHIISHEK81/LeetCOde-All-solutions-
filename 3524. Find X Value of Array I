//  3524. Find X Value of Array I  //



class Solution(object):
    def resultArray(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: List[int]
        """
        n = len(nums)
        
        if k == 1:
            return [(n * (n + 1)) // 2]
            
        ans = [0] * k
        prev_count = [0] * k
        
        for x in nums:
            r = x % k
            curr_count = [0] * k
            ans[r] += 1
            
            for j in range(k):
                if prev_count[j] > 0:
                    prod = (j * r) % k
                    curr_count[prod] += prev_count[j]
                    ans[prod] += prev_count[j]
                    
            curr_count[r] += 1
            prev_count = curr_count
            
        return ans
