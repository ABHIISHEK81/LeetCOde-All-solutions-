//  2089. Find Target Indices After Sorting Array  //



class Solution(object):
    def targetIndices(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        left = sum(x < target for x in nums)
        right = sum(x <= target for x in nums)  
        return list(range(left, right))
