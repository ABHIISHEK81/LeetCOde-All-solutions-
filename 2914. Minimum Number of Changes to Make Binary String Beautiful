//  2914. Minimum Number of Changes to Make Binary String Beautiful  //



class Solution(object):
    def minChanges(self, s):
        """
        :type s: str
        :rtype: int
        """
        res = 0
        for i in range(1,len(s),2):
            if s[i-1]!=s[i]:
                res+=1
        return res
