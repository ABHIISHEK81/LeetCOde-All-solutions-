//  3886. Sum of Sortable Integers  //




class Solution(object):
    def sortableIntegers(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        target = sorted(nums)

        def is_rotation(arr, expected):
            """Check whether expected is a cyclic rotation of arr."""
            m = len(arr)

            if m <= 1:
                return arr == expected

            lps = [0] * m
            j = 0

            for i in range(1, m):
                while j > 0 and expected[i] != expected[j]:
                    j = lps[j - 1]

                if expected[i] == expected[j]:
                    j += 1

                lps[i] = j
            j = 0

            for i in range(2 * m - 1):
                value = arr[i % m]

                while j > 0 and value != expected[j]:
                    j = lps[j - 1]

                if value == expected[j]:
                    j += 1

                if j == m:
                    return True

            return False

        answer = 0

        for k in range(1, n + 1):
            if n % k != 0:
                continue

            valid = True

            for start in range(0, n, k):
                block = nums[start:start + k]
                expected = target[start:start + k]

                if not is_rotation(block, expected):
                    valid = False
                    break

            if valid:
                answer += k

        return answer
