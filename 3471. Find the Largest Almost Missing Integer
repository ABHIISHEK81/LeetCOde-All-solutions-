//  3471. Find the Largest Almost Missing Integer  //




class Solution(object):
    def largestInteger(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        res = -1    
        if k == 1:
            d = Counter(nums)
            for i in d:
                if d[i] == 1:
                    res = max(res, i)
            return res
        if k == len(nums):
            return max(nums)
        
        d = {}
        for i in range(len(nums)-k+1):
            cur = nums[i:i+k]
            for j in cur:
                d[j] = d.get(j,0)+1
        
        for key in d:
            if d[key] == 1:
                res = max(key, res)
        return res
